{
	"compilerOptions": {
		"declaration": false,
		"emitDecoratorMetadata": true,
		"esModuleInterop": true,
		"experimentalDecorators": true,
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"outDir": "./dist",
		"rootDir": "./src",
		"skipLibCheck": false,
		"strict": true,
		"target": "ES2023",
		"types": ["node"]
	},
	"include": ["src/**/*.ts"]
}
