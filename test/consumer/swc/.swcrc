{
	"$schema": "https://swc.rs/schema.json",
	"jsc": {
		"baseUrl": "./",
		"keepClassNames": true,
		"parser": {
			"decorators": true,
			"dynamicImport": true,
			"syntax": "typescript"
		},
		"paths": {
			"@entity/*": ["src/entity/*"]
		},
		"target": "es2023",
		"transform": {
			"decoratorMetadata": true,
			"legacyDecorator": true,
			"useDefineForClassFields": false
		}
	},
	"module": {
		"resolveFully": true,
		"type": "es6"
	},
	"sourceMaps": false
}
