{
	"compilerOptions": {
		"emitDecoratorMetadata": true,
		"esModuleInterop": true,
		"experimentalDecorators": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"paths": {
			"@entity/*": ["./src/entity/*"]
		},
		"skipLibCheck": false,
		"strict": true,
		"strictPropertyInitialization": false,
		"target": "ES2023",
		"types": ["node"]
	},
	"include": ["src/**/*.ts"]
}
