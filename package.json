{
	"name": "@elsikora/nestjs-typeorm-aws-connector",
	"version": "3.0.0-dev.2",
	"description": "NestJS TypeORM connector for AWS SSM and Secrets Manager with bounded credential rotation",
	"homepage": "https://github.com/ElsiKora/NestJS-TypeORM-AWS-Connector#readme",
	"bugs": {
		"url": "https://github.com/ElsiKora/NestJS-TypeORM-AWS-Connector/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ElsiKora/NestJS-TypeORM-AWS-Connector"
	},
	"license": "MIT",
	"author": "ElsiKora",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"branch": "npx @elsikora/git-branch-lint -b",
		"prebuild": "rimraf dist",
		"build": "npm run prebuild && rollup -c",
		"postbuild": "node scripts/check-declaration-imports.cjs",
		"commit": "cz",
		"format": "prettier --check .",
		"format:fix": "prettier --write .",
		"lint": "eslint ./",
		"lint:all": "npm run lint && npm run lint:types",
		"lint:all:fix": "npm run lint:fix && npm run lint:types:fix",
		"lint:fix": "eslint --fix ./",
		"lint:test": "eslint \"{src,apps,libs,test}/**/*.spec.ts\"",
		"lint:types": "tsc --noEmit",
		"lint:types:fix": "tsc --noEmit --skipLibCheck",
		"lint:watch": "npx eslint-watch ./",
		"prepare": "husky",
		"release": "semantic-release",
		"test": "npm run build && npm run test:unit",
		"test:consumer": "node scripts/test/consumer-smoke.mjs",
		"test:unit": "node --test --test-timeout=60000 --test-force-exit test/typeorm-aws-connector/error-boundary.spec.mjs test/typeorm-aws-connector/rotator.service.spec.mjs test/typeorm-aws-connector/typeorm-aws-connector.module.spec.mjs"
	},
	"config": {
		"commitizen": {
			"path": "@elsikora/commitizen-plugin-commitlint-ai"
		}
	},
	"dependencies": {
		"@aws-sdk/client-secrets-manager": "^3.1161.0",
		"@nestjs/schedule": "^12.0.2"
	},
	"devDependencies": {
		"@aws-sdk/client-ssm": "^3.1161.0",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@elsikora/cladi": "^2.1.2",
		"@elsikora/commitizen-plugin-commitlint-ai": "^3.0.1",
		"@elsikora/eslint-config": "^3.10.2",
		"@elsikora/eslint-plugin-nestjs-typed": "^3.1.0",
		"@elsikora/git-branch-lint": "^1.2.2",
		"@elsikora/nestjs-aws-parameter-store-config": "3.0.0",
		"@nestjs/cli": "^12.0.11",
		"@nestjs/common": "^12.3.2",
		"@nestjs/config": "^12.0.1",
		"@nestjs/core": "^12.3.2",
		"@nestjs/schematics": "^12.0.12",
		"@nestjs/typeorm": "^12.0.2",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-typescript": "^12.3.1",
		"@saithodev/semantic-release-backmerge": "^4.0.1",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/git": "^11.0.1",
		"@semantic-release/github": "^12.0.10",
		"@semantic-release/npm": "^13.2.0",
		"@semantic-release/release-notes-generator": "^14.1.1",
		"@testcontainers/postgresql": "^12.2.1",
		"@types/node": "^26.6.6",
		"commitizen": "^4.3.2",
		"conventional-changelog-conventionalcommits": "^10.4.1",
		"eslint": "^10.14.0",
		"eslint-plugin-n": "^18.5.0",
		"eslint-plugin-ng-module-sort": "^1.4.0",
		"eslint-plugin-no-secrets": "^2.3.3",
		"eslint-plugin-typeorm-typescript": "^0.5.4",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"pg": "^8.23.1",
		"prettier": "^3.9.10",
		"reflect-metadata": "^0.2.2",
		"rimraf": "^6.1.3",
		"rollup": "^4.67.4",
		"rxjs": "^7.8.2",
		"semantic-release": "^25.0.9",
		"tslib": "^2.9.1",
		"typeorm": "^1.1.2",
		"typescript": "~6.0.3",
		"unplugin-dts": "^1.1.2"
	},
	"peerDependencies": {
		"@aws-sdk/client-ssm": ">=3.535.0 <4",
		"@elsikora/nestjs-aws-parameter-store-config": "^3.0.0",
		"@nestjs/common": ">=12.3.2 <13",
		"@nestjs/config": ">=12.0.1 <13",
		"@nestjs/core": ">=12.3.2 <13",
		"typeorm": ">=1.1.2 <2"
	},
	"engines": {
		"node": "^22.13.0 || >=24.11.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
